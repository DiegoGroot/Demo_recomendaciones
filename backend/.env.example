# ═════════════════════════════════════════════════════════════════════════════
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# 
# ⚠️  INSTRUCCIONES CRÍTICAS DE SEGURIDAD:
# 
# 1. NUNCA committees credenciales al repositorio Git
# 2. NUNCA hardcodees credenciales en el código Python
# 3. Copia este archivo como ".env" en tu ambiente local
# 4. Rellena los valores con tus credenciales reales
# 5. El archivo ".env" debe estar en .gitignore (ya está)
# 6. En producción, usa variables de entorno en el dashboard de Render
#
# ═════════════════════════════════════════════════════════════════════════════

# ─── Base de Datos (REQUERIDO) ────────────────────────────────────────────────
# Valores obligatorios. Sin ellos, la aplicación NO iniciará.
DB_HOST=tu-host.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=tu_password_aqui
DB_NAME=defaultdb
DB_PORT=27373
DB_SSL_CA=

# ─── Schema de Base de Datos (REQUERIDO) ──────────────────────────────────────
# Si tus tablas están en el schema "sira": DB_SCHEMA=sira
# Si están directamente en la BD (sin schema): DB_SCHEMA=
DB_SCHEMA=sira

# ─── Configuración de Aplicación ──────────────────────────────────────────────
API_HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO
